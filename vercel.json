{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "telegram": { "root": ".", "runtime": "container", "entrypoint": "Dockerfile" },
    "delivery": {
      "root": "delivery",
      "bindings": [
        { "type": "service", "service": "telegram", "format": "url", "env": "AUTH_WORKER_URL" }
      ],
      "functions": {
        "api/consume.js": {
          "experimentalTriggers": [{ "type": "queue/v2beta", "topic": "auth-delivery" }]
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/wake", "destination": { "service": "delivery" } },
    { "source": "/telegram", "destination": { "service": "telegram" } },
    { "source": "/health", "destination": { "service": "telegram" } }
  ]
}
